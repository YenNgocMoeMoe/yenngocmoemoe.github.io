---
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Dự án' },
  { href: '/writing', label: 'Bài viết' },
  { href: '/about', label: 'Về mình' },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Về trang chủ">{site.name}<span>✦</span></a>
  <nav aria-label="Điều hướng chính">
    {links.map((link) => (
      <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <a class="contact-link" href={`mailto:${site.email}`}>Trò chuyện ↗</a>
</header>

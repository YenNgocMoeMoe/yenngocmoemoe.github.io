---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { writingLinks } from '../../data/writing';
---
<BaseLayout title={`Bài viết — ${site.name}`}>
  <header class="page-intro section-pad">
    <p class="eyebrow">Published writing</p>
    <h1>Những bài viết<br /><em>đã được đăng.</em></h1>
    <p>Portfolio lưu lại nơi các bài viết đã xuất hiện. Mỗi liên kết sẽ đưa bạn đến nội dung gốc trên nền tảng đăng tải.</p>
  </header>
  <section class="external-writing-grid section-pad">
    {writingLinks.map((post, index) => (
      <a class="external-writing-card" href={post.url} target="_blank" rel="noreferrer">
        <div class="external-card-top">
          <span>0{index + 1}</span>
          <span class="platform-mark" aria-hidden="true">f</span>
        </div>
        <p class="eyebrow">Published on {post.platform}</p>
        <h2>{post.title}</h2>
        <p>{post.description}</p>
        <span class="external-cta">Đọc trên {post.platform} ↗</span>
      </a>
    ))}
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title={`Về mình — ${site.name}`}>
  <section class="about-page section-pad">
    <div class="about-title">
      <p class="eyebrow">About me</p>
      <h1>{site.aboutTitle}</h1>
    </div>
    <div class="about-photo"><span>Thay bằng ảnh<br />chân dung ngang</span></div>
    <div class="about-copy">
      <p class="lead">{site.aboutLead}</p>
      <p>{site.aboutBody}</p>
      <h2>Mình có thể giúp với</h2>
      <ul>{site.services.map((service) => <li>{service}</li>)}</ul>
      <h2>Mình quan tâm đến</h2>
      <ul>{site.interests.map((interest) => <li>{interest}</li>)}</ul>
      <div class="about-actions">
        <a class="button-link" href={`mailto:${site.email}`}>Liên hệ với mình ↗</a>
        {site.cv && <a class="button-link secondary" href={site.cv} target="_blank">Xem CV ↗</a>}
      </div>
    </div>
  </section>
</BaseLayout>

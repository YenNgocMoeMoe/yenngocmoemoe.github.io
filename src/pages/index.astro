---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CertificateGrid from '../components/CertificateGrid.astro';
import { site } from '../data/site';
import { writingLinks } from '../data/writing';

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero section-pad">
    <p class="eyebrow hero-kicker">{site.disciplines}</p>
    <h1>{site.heroLead} <em>{site.heroAccent}</em> {site.heroEnd}</h1>
    <div class="hero-bottom">
      <p>{site.intro}</p>
      <a href="#selected-work">Khám phá dự án <span>↓</span></a>
    </div>
    <div class="hero-stamp" aria-hidden="true">Based in<br />{site.location}<br />✦ {new Date().getFullYear()}</div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div>STRATEGY ✦ STORYTELLING ✦ SOCIAL CONTENT ✦ COMMUNITY ✦ CREATIVE PRODUCTION ✦&nbsp;</div>
    <div>STRATEGY ✦ STORYTELLING ✦ SOCIAL CONTENT ✦ COMMUNITY ✦ CREATIVE PRODUCTION ✦&nbsp;</div>
  </div>

  <section class="work-section section-pad" id="selected-work">
    <div class="section-heading">
      <p class="eyebrow">01 · Selected work</p>
      <h2>Những dự án<br />mình đặt cả trái tim vào.</h2>
      <a class="text-link" href="/work">Xem tất cả dự án →</a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} large={index === 0} />)}
    </div>
  </section>

  <section class="writing-section section-pad">
    <div class="section-heading compact">
      <p class="eyebrow">02 · Published writing</p>
      <h2>Những bài viết<br /><em>đã được đăng.</em></h2>
      <a class="text-link" href="/writing">Xem tất cả →</a>
    </div>
    <div class="post-list">
      {writingLinks.map((post, index) => (
        <a class="post-row external-post" href={post.url} target="_blank" rel="noreferrer">
          <span class="post-number">0{index + 1}</span>
          {post.available ? (
            <img class="writing-thumb" src={post.cover} alt="" loading="lazy" />
          ) : (
            <span class="platform-mark" aria-hidden="true">f</span>
          )}
          <div>
            <p class="eyebrow">{post.language} · Published on {post.platform}</p>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
            <p class="post-credit">{post.credit}</p>
          </div>
          <span class="post-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="certificate-section section-pad">
    <div class="section-heading compact">
      <p class="eyebrow">03 · Recognition</p>
      <h2>Những hành trình<br /><em>mình đã góp mặt.</em></h2>
      <a class="text-link" href="/certificates">Xem chứng nhận →</a>
    </div>
    <CertificateGrid />
  </section>

  <section class="about-teaser section-pad">
    <img class="portrait-placeholder" src="/images/anh-dai-dien.jpg" alt="Chân dung Nguyễn Yến Ngọc" loading="lazy" />
    <div>
      <p class="eyebrow">04 · A little about me</p>
      <blockquote>“{site.quote}”</blockquote>
      <p>{site.shortBio}</p>
      <a class="text-link" href="/about">Hiểu thêm về mình →</a>
    </div>
  </section>
</BaseLayout>
